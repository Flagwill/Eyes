{
  "name": "mio-eyes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check app.js && node --check eyes.js && node --check desktop.js && node --check server.mjs",
    "desktop:build": "cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo && cmake --build build -j2",
    "desktop": "npm run desktop:build && ./bin/mio show",
    "desktop:install": "bash packaging/install-user.sh"
  }
}

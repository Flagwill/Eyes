#!/usr/bin/env python3
"""Control the Eyes desktop eye overlay."""

from __future__ import annotations

import json
import os
import shutil
import socket
import subprocess
import sys
import time
from pathlib import Path


def runtime_socket() -> Path:
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if runtime:
        socket_path = Path(runtime) / "eyes.sock"
        return socket_path
    return Path("/tmp") / f"eyes-{os.getuid()}.sock"


def visibility_marker() -> Path:
    state_home = Path(
        os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")
    )
    return state_home / "eyes" / "user-visibility"


def user_suppressed() -> bool:
    try:
        visibility_marker().stat()
        return True
    except FileNotFoundError:
        return False
    except OSError:
        return True


def persist_user_suppression(reason: str) -> None:
    marker = visibility_marker()
    marker.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    marker.parent.chmod(0o700)
    temporary = marker.with_name(f".{marker.name}.{os.getpid()}.tmp")
    try:
        temporary.write_text(f"{reason}\n", encoding="utf-8")
        temporary.chmod(0o600)
        os.replace(temporary, marker)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def clear_user_suppression() -> None:
    try:
        visibility_marker().unlink()
    except FileNotFoundError:
        pass


AGENT_SOURCES = ("all", "codex", "claude", "pi", "opencode")


def agent_source_marker() -> Path:
    state_home = Path(
        os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")
    )
    return state_home / "eyes" / "agent-source"


def read_agent_source() -> str:
    try:
        value = agent_source_marker().read_text(encoding="utf-8").strip().lower()
    except OSError:
        return "all"
    return value if value in AGENT_SOURCES else "all"


def persist_agent_source(source: str) -> None:
    marker = agent_source_marker()
    marker.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    marker.parent.chmod(0o700)
    temporary = marker.with_name(f".{marker.name}.{os.getpid()}.tmp")
    try:
        temporary.write_text(f"{source}\n", encoding="utf-8")
        temporary.chmod(0o600)
        os.replace(temporary, marker)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def executable_candidates() -> list[Path]:
    explicit = os.environ.get("EYES_DESKTOP_BIN")
    script_dir = Path(__file__).resolve().parent
    project = script_dir.parent if script_dir.name == "bin" else script_dir
    values = [
        explicit,
        script_dir / "eyes-desktop",
        project / "build" / "eyes-desktop",
        shutil.which("eyes-desktop"),
    ]
    return [Path(value) for value in values if value]


def detached_host_pidfile() -> Path:
    cache = Path(
        os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")
    ) / "eyes"
    return cache / "host.pid"


def detached_host_running() -> bool:
    """Report whether a detached host from an earlier call is still alive.

    The pid file names the process and the command line check makes sure a
    recycled pid is not mistaken for the host. Without this guard every call
    that cannot reach the user manager would leave another host behind, and
    those hosts hold a socket no client of this session can reach.
    """
    try:
        pid = int(
            detached_host_pidfile().read_text(encoding="utf-8").strip()
        )
    except (OSError, ValueError):
        return False
    try:
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return False
    return b"eyes-desktop" in cmdline


def launch_desktop() -> None:
    executable = next(
        (
            path
            for path in executable_candidates()
            if path.is_file() and os.access(path, os.X_OK)
        ),
        None,
    )
    if executable is None:
        raise SystemExit(
            "找不到 eyes-desktop。请先运行 npm run desktop:build，"
            "或重新安装桌面组件。"
        )

    systemd_run = shutil.which("systemd-run")
    systemctl = shutil.which("systemctl")
    manager_ready = False
    if systemctl:
        manager_ready = subprocess.run(
            [systemctl, "--user", "show-environment"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        ).returncode == 0
        if manager_ready:
            durable = subprocess.run(
                [systemctl, "--user", "start", "eyes-desktop.service"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            if durable.returncode == 0:
                return

    if systemd_run and systemctl and manager_ready:
        command = [
            systemd_run,
            "--user",
            "--unit=eyes-desktop-transient",
            "--collect",
            "--quiet",
            "--description=Eyes",
            str(executable),
            "--hidden",
        ]
        for variable in (
            "DISPLAY",
            "WAYLAND_DISPLAY",
            "XAUTHORITY",
            "DBUS_SESSION_BUS_ADDRESS",
            "XDG_RUNTIME_DIR",
            "XDG_CURRENT_DESKTOP",
            "XDG_SESSION_TYPE",
        ):
            value = os.environ.get(variable)
            if value:
                command.insert(-2, f"--setenv={variable}={value}")
        launched = subprocess.run(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if launched.returncode == 0:
            return

    cache = Path(
        os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")
    ) / "eyes"
    cache.mkdir(parents=True, exist_ok=True)
    if detached_host_running():
        return
    log = (cache / "desktop.log").open("ab")
    host = subprocess.Popen(
        [str(executable), "--hidden"],
        stdin=subprocess.DEVNULL,
        stdout=log,
        stderr=log,
        close_fds=True,
        start_new_session=True,
    )
    try:
        detached_host_pidfile().write_text(f"{host.pid}\n", encoding="utf-8")
    except OSError:
        pass


def connect(timeout: float) -> socket.socket:
    sock_path = runtime_socket()
    deadline = time.monotonic() + timeout
    while True:
        client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            client.connect(str(sock_path))
            return client
        except OSError:
            client.close()
            if time.monotonic() >= deadline:
                raise
            time.sleep(0.12)


def send(command: str, *, autostart: bool = True) -> dict:
    try:
        client = connect(0.05)
    except OSError:
        if not autostart:
            return {
                "ok": True,
                "running": False,
                "visible": False,
                "suppressed": user_suppressed(),
            }
        launch_desktop()
        client = connect(8.0)

    with client:
        client.sendall((command.strip() + "\n").encode("utf-8"))
        client.shutdown(socket.SHUT_WR)
        chunks = []
        while True:
            chunk = client.recv(4096)
            if not chunk:
                break
            chunks.append(chunk)

    raw = b"".join(chunks).strip()
    if not raw:
        return {"ok": True, "running": True}
    return json.loads(raw.decode("utf-8"))


def usage() -> str:
    return """用法:
  eyes show | hide | toggle
  eyes start | thinking | working | waiting | complete | idle
  eyes activity ID              具体工作状态（见 README）
  eyes host-start
  eyes blink [double]
  eyes look X Y [SECONDS]       X/Y 范围 -1 到 1
  eyes emotion ID
  eyes status
  eyes agent [NAME]            选择跟随的 Agent（all/codex/claude/pi/opencode）
  eyes demo
  eyes quit

直接运行 eyes 等同于 eyes show。"""


def stop_desktop_service() -> None:
    systemctl = shutil.which("systemctl")
    if not systemctl:
        return
    try:
        subprocess.run(
            [systemctl, "--user", "stop", "eyes-desktop.service"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=3,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


def desktop_service_active() -> bool:
    systemctl = shutil.which("systemctl")
    if not systemctl:
        return False
    return (
        subprocess.run(
            [
                systemctl,
                "--user",
                "is-active",
                "--quiet",
                "eyes-desktop.service",
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        ).returncode
        == 0
    )


def wait_for_desktop_shutdown(timeout: float = 25.0) -> None:
    """Give the host time to restore the wallpaper before stopping systemd."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if not runtime_socket().exists():
            if not desktop_service_active():
                return
        time.sleep(0.1)
    stop_desktop_service()


def main() -> int:
    command = "show" if len(sys.argv) == 1 else " ".join(sys.argv[1:]).strip()

    if command in {"-h", "--help", "help"}:
        print(usage())
        return 0

    primary_command = command.split(maxsplit=1)[0]

    if primary_command == "agent":
        parts = command.split()
        requested = parts[1].strip().lower() if len(parts) > 1 else ""
        if requested:
            if requested not in AGENT_SOURCES:
                print(
                    f"未知的 Agent：{requested}\n"
                    f"可选：{' '.join(AGENT_SOURCES)}",
                    file=sys.stderr,
                )
                return 2
            persist_agent_source(requested)
            # The host drops the state of the agent that is no longer
            # followed, so the wallpaper does not keep showing it.
            try:
                send("agent " + requested, autostart=False)
            except (OSError, ValueError, json.JSONDecodeError):
                pass
            print(requested)
            return 0
        try:
            response = send("agent", autostart=False)
        except (OSError, ValueError, json.JSONDecodeError):
            response = {}
        print(response.get("agent") or read_agent_source())
        return 0

    if primary_command == "host-start":
        if user_suppressed():
            print("Eyes 保持用户隐藏状态")
            return 0
        try:
            with connect(0.05):
                pass
        except OSError:
            launch_desktop()
            try:
                with connect(8.0):
                    pass
            except OSError as error:
                print(f"Eyes 桌面组件启动失败：{error}", file=sys.stderr)
                return 1
        print("Eyes 后台已启动")
        return 0

    try:
        if primary_command in {"show", "toggle"}:
            clear_user_suppression()
        elif primary_command == "hide":
            persist_user_suppression("hidden")
        elif primary_command == "quit":
            persist_user_suppression("quit")
    except OSError as error:
        print(f"Eyes 无法保存显示意图：{error}", file=sys.stderr)
        return 1

    autostart = primary_command not in {
        "status",
        "hide",
        "idle",
        "quit",
    }
    if user_suppressed() and primary_command not in {"show", "toggle"}:
        autostart = False

    try:
        response = send(command, autostart=autostart)
    except (OSError, ValueError, json.JSONDecodeError) as error:
        print(f"Eyes 桌面组件连接失败：{error}", file=sys.stderr)
        return 1

    if primary_command == "quit":
        # A clean host exit performs a blocking wallpaper restore. Stopping
        # systemd immediately would SIGTERM it before that restore can run.
        wait_for_desktop_shutdown()

    if primary_command == "status":
        print(json.dumps(response, ensure_ascii=False, indent=2))
        return 0 if response.get("running") is not False else 1
    if not response.get("ok", True):
        print(response.get("error", "命令执行失败"), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
